{%- if section.blocks.size > 0 -%}
  <div
    class="announcement"
    style="--ann-bg: {{ section.settings.background }}; --ann-color: {{ section.settings.text_color }};"
    data-announcement
    data-interval="{{ section.settings.interval }}"
  >
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="announcement__nav announcement__nav--prev" data-ann-prev aria-label="{{ 'general.previous' | t }}">
        {% render 'icon', icon: 'arrow-left' %}
      </button>
    {%- endif -%}
    <div class="announcement__track" aria-live="polite">
      {%- for block in section.blocks -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.text }}</span>
          {%- if block.settings.link_text != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="announcement__cta">{{ block.settings.link_text }}</a>
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="announcement__nav announcement__nav--next" data-ann-next aria-label="{{ 'general.next' | t }}">
        {% render 'icon', icon: 'arrow-right' %}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de avisos",
  "class": "section-announcement",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Cor de fundo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Troca automática",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "15% OFF na 1ª compra. Cupom: WELCOME"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Texto do link",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de avisos",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
