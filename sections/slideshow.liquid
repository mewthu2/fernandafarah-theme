<div
  class="slideshow slideshow--{{ section.settings.height }}"
  data-slideshow
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="slideshow__track" data-slides>
    {%- for block in section.blocks -%}
      {%- liquid
        assign loading = 'lazy'
        assign fetch = 'auto'
        if forloop.first and section.index <= 2
          assign loading = 'eager'
          assign fetch = 'high'
        endif
      -%}
      <div
        class="slide{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ forloop.length }}"
        style="--slide-color: {{ block.settings.text_color }};"
        data-slide
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="slide__cover-link" tabindex="-1" aria-hidden="true"></a>
        {%- endif -%}

        <div class="slide__media">
          {%- if block.settings.video_url != blank -%}
            <video
              class="slide__video{% if block.settings.video_url_mobile != blank %} hide-mobile{% endif %}"
              src="{{ block.settings.video_url }}"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              {% if block.settings.image != blank %}
                poster="{{ block.settings.image | image_url: width: 1920 }}"
              {% endif %}
            ></video>
            {%- if block.settings.video_url_mobile != blank -%}
              <video class="slide__video hide-desktop" src="{{ block.settings.video_url_mobile }}" autoplay muted loop playsinline preload="metadata"></video>
            {%- endif -%}
          {%- elsif block.settings.image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w">
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  loading: loading,
                  fetchpriority: fetch,
                  sizes: '100vw',
                  widths: '750, 1100, 1500, 1920, 2400',
                  class: 'slide__img'
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'slide__img placeholder' }}
          {%- endif -%}
        </div>

        <div class="slide__content slide__content--{{ block.settings.position }} slide__content--mobile-{{ block.settings.position_mobile }}">
          <div class="slide__box text-{{ block.settings.alignment }}">
            {%- if block.settings.title_image != blank -%}
              {{
                block.settings.title_image
                | image_url: width: 1000
                | image_tag: loading: loading, class: 'slide__title-img', sizes: '(min-width: 750px) 35vw, 70vw', widths: '400, 700, 1000'
              }}
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="slide__sub">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="slide__heading heading-xl">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.link | default: '#' }}" class="button button--{{ block.settings.button_style }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slide-prev aria-label="{{ 'general.previous' | t }}">
      {% render 'icon', icon: 'arrow-left' %}
    </button>
    <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slide-next aria-label="{{ 'general.next' | t }}">
      {% render 'icon', icon: 'arrow-right' %}
    </button>
    <div class="slideshow__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="slideshow__dot{% if forloop.first %} is-active{% endif %}"
          data-slide-to="{{ forloop.index0 }}"
          aria-label="{{ 'general.slide' | t: number: forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "full", "label": "Tela cheia" },
        { "value": "large", "label": "Grande" },
        { "value": "medium", "label": "Média" },
        { "value": "adapt", "label": "Adaptar à imagem" }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Troca automática",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Intervalo",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Descrição para acessibilidade",
      "default": "Destaques"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem desktop",
          "info": "Recomendado 2400 x 1200px"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem mobile",
          "info": "Recomendado 750 x 1300px"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "URL de vídeo MP4 (desktop)",
          "info": "Substitui a imagem. Use um link .mp4 (ex.: Arquivos do Shopify)."
        },
        {
          "type": "text",
          "id": "video_url_mobile",
          "label": "URL de vídeo MP4 (mobile)"
        },
        {
          "type": "header",
          "content": "Conteúdo"
        },
        {
          "type": "image_picker",
          "id": "title_image",
          "label": "Título em imagem (PNG/SVG)",
          "info": "Opcional, para lettering da campanha."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Nova coleção"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão",
          "default": "DESCUBRA"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Estilo do botão",
          "options": [
            { "value": "outline-light", "label": "Contorno claro" },
            { "value": "light", "label": "Sólido claro" },
            { "value": "outline", "label": "Contorno escuro" },
            { "value": "primary", "label": "Sólido escuro" }
          ],
          "default": "outline-light"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Cor do texto",
          "default": "#FFFFFF"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Posição (desktop)",
          "options": [
            { "value": "top-left", "label": "Topo à esquerda" },
            { "value": "top-center", "label": "Topo ao centro" },
            { "value": "top-right", "label": "Topo à direita" },
            { "value": "middle-left", "label": "Meio à esquerda" },
            { "value": "middle-center", "label": "Centro" },
            { "value": "middle-right", "label": "Meio à direita" },
            { "value": "bottom-left", "label": "Base à esquerda" },
            { "value": "bottom-center", "label": "Base ao centro" },
            { "value": "bottom-right", "label": "Base à direita" }
          ],
          "default": "middle-right"
        },
        {
          "type": "select",
          "id": "position_mobile",
          "label": "Posição (mobile)",
          "options": [
            { "value": "top", "label": "Topo" },
            { "value": "middle", "label": "Centro" },
            { "value": "bottom", "label": "Base" }
          ],
          "default": "bottom"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "Alinhamento",
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
