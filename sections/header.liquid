{%- liquid
  assign menu = section.settings.menu
  assign transparent = false
  if section.settings.transparent_home and request.page_type == 'index'
    assign transparent = true
  endif
-%}

<header
  class="header header--{{ section.settings.layout }}{% if transparent %} header--transparent{% endif %}{% if section.settings.sticky %} header--sticky{% endif %}"
  data-header
>
  <div class="header__inner page-width">
    <div class="header__left">
      <button type="button" class="icon-btn header__burger" data-menu-open aria-label="{{ 'header.menu' | t }}" aria-controls="MenuDrawer">
        {% render 'icon', icon: 'menu' %}
      </button>
      <button type="button" class="icon-btn header__search-mobile" data-search-open aria-label="{{ 'search.title' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>
      {%- if section.settings.layout == 'logo_center' -%}
        <div class="header__utility">
          {%- for link in section.settings.utility_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="header__logo">
      {%- if request.page_type == 'index' -%}<h1 class="header__logo-heading">{%- endif -%}
      <a href="{{ routes.root_url }}" class="header__logo-link">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'header__logo-img header__logo-img--default',
              alt: logo_alt,
              widths: '150, 300, 450, 600',
              sizes: '(min-width: 750px) var(--logo-width), 40vw',
              loading: 'eager'
          }}
          {%- if settings.logo_inverse != blank and transparent -%}
            {{
              settings.logo_inverse
              | image_url: width: 600
              | image_tag:
                class: 'header__logo-img header__logo-img--inverse',
                alt: logo_alt,
                widths: '150, 300, 450, 600',
                sizes: '(min-width: 750px) var(--logo-width), 40vw',
                loading: 'eager'
            }}
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}</h1>{%- endif -%}
    </div>

    <nav class="header__nav" aria-label="{{ 'header.main_menu' | t }}">
      <ul class="nav" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign promo = nil
            assign link_title_down = link.title | downcase | strip
            for block in section.blocks
              assign target_title = block.settings.menu_item | downcase | strip
              if target_title == link_title_down
                assign promo = block
              endif
            endfor
            assign has_panel = false
            if link.links.size > 0 or promo
              assign has_panel = true
            endif
          -%}
          <li class="nav__item{% if has_panel %} nav__item--has-panel{% endif %}" data-nav-item>
            <a
              href="{{ link.url }}"
              class="nav__link{% if link.active or link.child_active %} is-active{% endif %}"
              {% if has_panel %}
                aria-haspopup="true" aria-expanded="false"
              {% endif %}
              {% if link.title contains 'SALE' or link.title contains 'Sale' %}
                data-highlight
              {% endif %}
            >
              {{- link.title -}}
            </a>
            {%- if has_panel -%}
              <div class="mega" data-mega>
                <div class="mega__inner page-width">
                  <div class="mega__columns">
                    {%- for child in link.links -%}
                      <div class="mega__col">
                        <a href="{{ child.url }}" class="mega__heading">{{ child.title }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul role="list">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}" class="mega__link">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                          <a href="{{ child.url }}" class="mega__all">{{ 'header.see_all' | t }}</a>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                  {%- if promo -%}
                    <a href="{{ promo.settings.link | default: link.url }}" class="mega__promo" {{ promo.shopify_attributes }}>
                      {%- if promo.settings.image != blank -%}
                        {{ promo.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '300px', widths: '300, 450, 600', class: 'mega__promo-img' }}
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'mega__promo-img placeholder' }}
                      {%- endif -%}
                      {%- if promo.settings.caption != blank -%}
                        <span class="mega__promo-caption">{{ promo.settings.caption }}</span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      {%- if section.settings.layout == 'logo_left' -%}
        <div class="header__utility">
          {%- for link in section.settings.utility_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <button type="button" class="icon-btn header__search-desktop" data-search-open aria-label="{{ 'search.title' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-btn header__account" aria-label="{{ 'header.account' | t }}">
          {% render 'icon', icon: 'account' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-btn header__cart" data-cart-open aria-label="{{ 'cart.title' | t }}">
        {% render 'icon', icon: 'bag' %}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="menu-drawer" id="MenuDrawer" data-menu-drawer aria-hidden="true">
  <div class="menu-drawer__overlay" data-drawer-close></div>
  <div class="menu-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'header.menu' | t }}</span>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>
    <nav class="menu-drawer__nav" aria-label="{{ 'header.main_menu' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details class="menu-drawer__details">
                <summary>{{ link.title }} {% render 'icon', icon: 'chevron-down' %}</summary>
                <ul role="list">
                  <li><a href="{{ link.url }}" class="menu-drawer__all">{{ 'header.see_all' | t }}</a></li>
                  {%- for child in link.links -%}
                    <li>
                      {%- if child.links.size > 0 -%}
                        <details class="menu-drawer__details menu-drawer__details--sub">
                          <summary>{{ child.title }} {% render 'icon', icon: 'chevron-down' %}</summary>
                          <ul role="list">
                            <li><a href="{{ child.url }}" class="menu-drawer__all">{{ 'header.see_all' | t }}</a></li>
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- else -%}
                        <a href="{{ child.url }}">{{ child.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="menu-drawer__top">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="menu-drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          {% render 'icon', icon: 'account' %}
          {% if customer %}{{ 'header.my_account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}
        </a>
      {%- endif -%}
      {%- for link in section.settings.utility_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cabeçalho",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu",
      "info": "Use 3 níveis: item > coluna > links para montar o mega menu."
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "Links auxiliares",
      "info": "Ex.: Encontre uma loja, Compre pelo WhatsApp"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "logo_left", "label": "Logo à esquerda, menu ao centro" },
        { "value": "logo_center", "label": "Logo centralizado, menu abaixo" }
      ],
      "default": "logo_left"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Fixar ao rolar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparente sobre o banner da página inicial",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Imagem do mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Item do menu",
          "info": "Nome exato do item do menu principal. Ex.: NOVIDADES",
          "default": "NOVIDADES"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Legenda",
          "default": "Nova coleção"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
