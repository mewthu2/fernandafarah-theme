<div class="account-form page-width page-width--narrow">
  <h1 class="page-title">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="ResetPassword">{{ 'customer.password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Redefinir senha", "class": "section-reset", "settings": [] }
{% endschema %}
