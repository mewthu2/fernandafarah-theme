<div class="video-section section-spacing{% if section.settings.full_width == false %} page-width{% endif %}" style="--banner-mt: {{ section.settings.margin_top }}px; --banner-mb: {{ section.settings.margin_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="section-title text-center">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="video-section__frame ratio-{{ section.settings.ratio }}">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: section.settings.autoplay, loop: true, muted: section.settings.autoplay, playsinline: true, controls: section.settings.controls, class: 'video-section__media', image_size: '1920x' }}
    {%- elsif section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe class="video-section__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls={% if section.settings.controls %}1{% else %}0{% endif %}&playsinline=1" title="{{ section.settings.heading | default: 'Video' | escape }}" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
      {%- else -%}
        <iframe class="video-section__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&muted=1&loop=1&background={% if section.settings.controls %}0{% else %}1{% endif %}" title="{{ section.settings.heading | default: 'Video' | escape }}" allow="autoplay; fullscreen" allowfullscreen loading="lazy"></iframe>
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'video-section__media placeholder' }}
    {%- endif -%}
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="slide__cover-link" aria-label="{{ section.settings.heading | default: 'video' | escape }}"></a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vídeo",
  "class": "section-video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "video", "id": "video", "label": "Vídeo (upload Shopify)" },
    { "type": "video_url", "id": "video_url", "label": "Ou URL YouTube/Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "url", "id": "link", "label": "Link ao clicar" },
    { "type": "checkbox", "id": "autoplay", "label": "Reprodução automática (sem som)", "default": true },
    { "type": "checkbox", "id": "controls", "label": "Mostrar controles", "default": false },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporção",
      "options": [
        { "value": "landscape", "label": "16:9" },
        { "value": "wide", "label": "21:9" },
        { "value": "portrait", "label": "Retrato" }
      ],
      "default": "landscape"
    },
    { "type": "checkbox", "id": "full_width", "label": "Largura total", "default": true },
    { "type": "range", "id": "margin_top", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "presets": [
    { "name": "Vídeo" }
  ]
}
{% endschema %}
