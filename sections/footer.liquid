<footer class="footer" style="--footer-bg: {{ section.settings.background }}; --footer-color: {{ section.settings.text_color }};">
  <div class="footer__top page-width">
    {%- if section.settings.show_newsletter -%}
      <div class="footer__newsletter">
        <h2 class="footer__news-title">{{ section.settings.newsletter_title }}</h2>
        {%- if section.settings.newsletter_text != blank -%}
          <div class="footer__news-text">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}
        {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <div class="newsletter-form__fields">
              <label class="visually-hidden" for="NewsletterName">{{ 'newsletter.name' | t }}</label>
              <input id="NewsletterName" type="text" name="contact[first_name]" placeholder="{{ 'newsletter.name' | t }}" autocomplete="given-name">
              <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
              <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
              <button type="submit" class="newsletter-form__submit">{{ 'newsletter.submit' | t }}</button>
            </div>
            {%- if form.errors -%}
              <div class="form-error">{{ form.errors | default_errors }}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
        {%- if section.settings.newsletter_legal != blank -%}
          <div class="footer__legal">{{ section.settings.newsletter_legal }}</div>
        {%- endif -%}

        <ul class="footer__social" role="list">
          {%- assign socials = 'instagram,facebook,tiktok,pinterest,youtube,spotify' | split: ',' -%}
          {%- for social in socials -%}
            {%- assign key = 'social_' | append: social -%}
            {%- if settings[key] != blank -%}
              <li>
                <a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ social | capitalize }}">
                  {% render 'icon', icon: social %}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="footer__blocks">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <details class="footer__details" open>
                <summary class="footer__heading">{{ block.settings.title | default: block.settings.menu.title }} {% render 'icon', icon: 'chevron-down' %}</summary>
                <ul role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- when 'text' -%}
              <details class="footer__details" open>
                <summary class="footer__heading">{{ block.settings.title }} {% render 'icon', icon: 'chevron-down' %}</summary>
                <div class="footer__rte">{{ block.settings.text }}</div>
              </details>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__bottom page-width">
    {%- if section.settings.show_payment -%}
      <div class="footer__payments">
        {%- if section.settings.payment_title != blank -%}
          <p class="footer__heading">{{ section.settings.payment_title }}</p>
        {%- endif -%}
        {%- if section.settings.payment_text != blank -%}
          <p class="footer__small">{{ section.settings.payment_text }}</p>
        {%- endif -%}
        <ul class="footer__payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    <div class="footer__copy">
      {%- if section.settings.company_info != blank -%}
        <div class="footer__small">{{ section.settings.company_info }}</div>
      {%- endif -%}
      <p class="footer__small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Cor de fundo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostrar newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título",
      "default": "Cadastre-se em nossa newsletter"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Texto",
      "default": "<p>Receba as novidades e fique por dentro de serviços exclusivos!</p>"
    },
    {
      "type": "richtext",
      "id": "newsletter_legal",
      "label": "Aviso de privacidade",
      "default": "<p>Utilizamos os dados preenchidos para você usar as funcionalidades da nossa loja. Ao concluir o cadastro, você permite o tratamento de dados pessoais para a finalidade proposta.</p>"
    },
    {
      "type": "header",
      "content": "Pagamento e informações"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Mostrar formas de pagamento",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_title",
      "label": "Título pagamento",
      "default": "Formas de pagamento"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Texto pagamento",
      "default": "Parcelamento em até 8x sem juros"
    },
    {
      "type": "richtext",
      "id": "company_info",
      "label": "Dados da empresa",
      "default": "<p>Razão social LTDA · CNPJ 00.000.000/0001-00 · Endereço</p>"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Institucional"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Atendimento"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Atendimento sobre o seu pedido ou devolução.</p><p>Segunda a sexta, das 8h às 18h.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
