<div class="account page-width section-spacing" style="--banner-mt: 32px; --banner-mb: 48px;">
  <a href="{{ routes.account_url }}" class="link-underline">{{ 'customer.order.back' | t }}</a>
  <h1 class="page-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p>{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
  {%- if order.cancelled -%}
    <p>{{ 'customer.order.cancelled' | t }}: {{ order.cancel_reason_label }}</p>
  {%- endif -%}
  <table class="table">
    <thead>
      <tr>
        <th>{{ 'customer.order.product' | t }}</th>
        <th>{{ 'customer.order.quantity' | t }}</th>
        <th>{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            {{ line_item.title | link_to: line_item.product.url }}
            {%- if line_item.fulfillment -%}
              <br><small>{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}
              {%- if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}" class="link-underline">{{ 'customer.order.track' | t }}</a>{% endif -%}
              </small>
            {%- endif -%}
          </td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="2">{{ 'cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr><td colspan="2">{{ shipping_method.title }}</td><td>{{ shipping_method.price | money }}</td></tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr><td colspan="2">{{ tax_line.title }}</td><td>{{ tax_line.price | money }}</td></tr>
      {%- endfor -%}
      <tr><td colspan="2"><b>{{ 'customer.order.total' | t }}</b></td><td><b>{{ order.total_price | money_with_currency }}</b></td></tr>
    </tfoot>
  </table>
  <div class="account__grid">
    <div>
      <h2 class="section-title">{{ 'customer.order.billing' | t }}</h2>
      {{ order.billing_address | format_address }}
    </div>
    <div>
      <h2 class="section-title">{{ 'customer.order.shipping' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Pedido", "class": "section-order", "settings": [] }
{% endschema %}
