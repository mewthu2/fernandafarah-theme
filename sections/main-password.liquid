<div class="password">
  <div class="password__inner">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: class: 'password__logo', alt: shop.name }}
    {%- else -%}
      <h1 class="header__logo-text">{{ shop.name }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__fields">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.email' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
          <button type="submit" class="newsletter-form__submit">{{ 'newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label>
        <input type="password" id="Password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Senha",
  "class": "section-password",
  "settings": []
}
{% endschema %}
