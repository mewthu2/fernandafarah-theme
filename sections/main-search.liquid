<div class="collection search-page" style="--grid-cols-desktop: {{ section.settings.columns }};">
  <div class="collection__header page-width">
    <h1 class="collection__title">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="hidden" name="type" value="product">
      <label for="SearchPageInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="icon-btn" aria-label="{{ 'search.submit' | t }}">{% render 'icon', icon: 'search' %}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.per_page -%}
      {% render 'facets', results: search, count: search.results_count, terms: search.terms %}
      <div class="page-width-wide">
        {%- if search.results.size > 0 -%}
          <ul class="product-grid product-grid--collection" role="list" data-product-grid>
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a href="{{ item.url }}" class="search-page__item">
                    <span class="eyebrow">{{ item.object_type }}</span>
                    <span>{{ item.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate, style: 'load_more' %}
        {%- else -%}
          <div class="empty-state"><p>{{ 'search.no_results' | t: terms: search.terms }}</p></div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Resultados da busca",
  "class": "section-main-search",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Produtos por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Colunas (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
