{%- liquid
  capture look_handles
    render 'look-products', product: product, metafield: section.settings.metafield
  endcapture
  assign look_handles = look_handles | strip | split: ','

  assign look_image = section.settings.image
  if section.settings.image_metafield != blank
    assign img_parts = section.settings.image_metafield | strip | split: '.'
    if img_parts.size == 2
      assign mf_image = product.metafields[img_parts[0]][img_parts[1]].value
      if mf_image != blank
        assign look_image = mf_image
      endif
    endif
  endif
  if look_image == blank
    if section.settings.image_source == 'second' and product.media.size > 1
      assign look_image = product.media[1].preview_image
    elsif product.featured_media
      assign look_image = product.featured_media.preview_image
    endif
  endif
-%}

{%- if look_handles.size > 0 -%}
  <div
    class="shelf look section-spacing{% if look_image == blank %} look--no-image{% endif %}"
    id="CompreOLook"
    style="--banner-mt: {{ section.settings.margin_top }}px; --banner-mb: {{ section.settings.margin_bottom }}px; --look-cols: {{ section.settings.columns }};"
  >
    <div class="look__inner page-width">
      {%- if look_image != blank -%}
        <div class="look__media">
          {{
            look_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 40vw, 100vw',
              widths: '450, 600, 800, 1000, 1200, 1400',
              class: 'look__img',
              alt: product.title
          }}
          <span class="look__badge">{{ 'products.look.pieces' | t: count: look_handles.size }}</span>
        </div>
      {%- endif -%}

      <div class="look__content">
        <div class="shelf__header look__header">
          <div>
            {%- if section.settings.subheading != blank -%}
              <p class="eyebrow">{{ section.settings.subheading }}</p>
            {%- endif -%}
            <h2 class="section-title">{{ section.settings.heading }}</h2>
          </div>
          {%- if look_handles.size > 1 -%}
            <div class="shelf__actions">
              <button type="button" class="icon-btn" data-scroll-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', icon: 'arrow-left' %}</button>
              <button type="button" class="icon-btn" data-scroll-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'arrow-right' %}</button>
            </div>
          {%- endif -%}
        </div>

        <ul class="look__scroller" role="list" data-scroller>
          {%- for handle in look_handles limit: 12 -%}
            {%- assign look_product = all_products[handle] -%}
            {%- if look_product != blank -%}
              <li>{% render 'product-card', product: look_product, quick_inline: true, sizes: '(min-width: 990px) 20vw, 60vw' %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Compre o look",
  "class": "section-look",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "metafield",
      "label": "Metacampo com os produtos do look",
      "info": "Formato namespace.chave. Tipo: referência de produto (lista).",
      "default": "custom.compre_junto"
    },
    { "type": "header", "content": "Foto do look" },
    {
      "type": "text",
      "id": "image_metafield",
      "label": "Metacampo com a foto do look",
      "info": "Opcional. Formato namespace.chave. Tipo: arquivo (imagem). Tem prioridade sobre as opções abaixo.",
      "default": "custom.foto_look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto fixa",
      "info": "Usada quando o produto não tem foto do look no metacampo."
    },
    {
      "type": "select",
      "id": "image_source",
      "label": "Sem foto definida, usar",
      "options": [
        { "value": "featured", "label": "Foto principal do produto" },
        { "value": "second", "label": "Segunda foto do produto" }
      ],
      "default": "featured"
    },
    { "type": "header", "content": "Conteúdo" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Complete sua produção" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Compre o look" },
    { "type": "range", "id": "columns", "label": "Peças visíveis (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "margin_top", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "margin_bottom", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "Compre o look" }
  ]
}
{% endschema %}
