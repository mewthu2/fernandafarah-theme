{%- liquid
  capture look_handles
    render 'look-products', product: product, metafield: section.settings.metafield
  endcapture
  assign look_handles = look_handles | strip | split: ','
-%}

{%- if look_handles.size > 0 -%}
  <div
    class="shelf look section-spacing"
    id="CompreOLook"
    style="--banner-mt: {{ section.settings.margin_top }}px; --banner-mb: {{ section.settings.margin_bottom }}px; --shelf-cols: {{ section.settings.columns }};"
  >
    <div class="shelf__header page-width">
      <div>
        {%- if section.settings.subheading != blank -%}
          <p class="eyebrow">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      {%- if look_handles.size > section.settings.columns -%}
        <div class="shelf__actions">
          <button type="button" class="icon-btn" data-scroll-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', icon: 'arrow-left' %}</button>
          <button type="button" class="icon-btn" data-scroll-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'arrow-right' %}</button>
        </div>
      {%- endif -%}
    </div>
    <ul class="product-scroller" role="list" data-scroller>
      {%- for handle in look_handles limit: 12 -%}
        {%- assign look_product = all_products[handle] -%}
        {%- if look_product != blank -%}
          <li>{% render 'product-card', product: look_product %}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Compre o look",
  "class": "section-look",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "metafield",
      "label": "Metacampo com os produtos do look",
      "info": "Formato namespace.chave. Tipo: referência de produto (lista).",
      "default": "custom.compre_junto"
    },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Complete sua produção" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Compre o look" },
    { "type": "range", "id": "columns", "label": "Produtos por linha (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "margin_top", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "margin_bottom", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "Compre o look" }
  ]
}
{% endschema %}
