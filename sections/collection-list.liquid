<div class="cat-list cat-list--{{ section.settings.style }} section-spacing" style="--banner-mt: {{ section.settings.margin_top }}px; --banner-mb: {{ section.settings.margin_bottom }}px; --cols: {{ section.settings.columns }};">
  {%- if section.settings.heading != blank -%}
    <div class="page-width"><h2 class="section-title text-center">{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <ul class="cat-list__items page-width" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign img = block.settings.image | default: col.featured_image
        assign title = block.settings.title | default: col.title
        assign url = block.settings.link | default: col.url
      -%}
      <li class="cat-list__item" {{ block.shopify_attributes }}>
        <a href="{{ url | default: '#' }}">
          <div class="cat-list__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 20vw, 45vw', widths: '250, 400, 550, 700', class: 'cat-list__img' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'cat-list__img placeholder' }}
            {%- endif -%}
          </div>
          <span class="cat-list__title">{{ title | default: 'Categoria' }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Categorias",
  "class": "section-cat-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Compre por categoria" },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "tiles", "label": "Retângulos" },
        { "value": "circles", "label": "Círculos" }
      ],
      "default": "tiles"
    },
    { "type": "range", "id": "columns", "label": "Colunas (desktop)", "min": 2, "max": 8, "step": 1, "default": 5 },
    { "type": "range", "id": "margin_top", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "margin_bottom", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Imagem personalizada" },
        { "type": "text", "id": "title", "label": "Título personalizado" },
        { "type": "url", "id": "link", "label": "Link personalizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias",
      "blocks": [
        { "type": "collection", "settings": { "title": "Vestidos" } },
        { "type": "collection", "settings": { "title": "Blusas" } },
        { "type": "collection", "settings": { "title": "Calças" } },
        { "type": "collection", "settings": { "title": "Saias" } },
        { "type": "collection", "settings": { "title": "Acessórios" } }
      ]
    }
  ]
}
{% endschema %}
