<div class="account-form page-width page-width--narrow">
  <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row">
      <div class="field">
        <label for="RegFirst">{{ 'customer.first_name' | t }}</label>
        <input type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="RegLast">{{ 'customer.last_name' | t }}</label>
        <input type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name">
      </div>
    </div>
    <div class="field">
      <label for="RegEmail">{{ 'customer.email' | t }}</label>
      <input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="RegPassword">{{ 'customer.password' | t }}</label>
      <input type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <label class="checkbox">
      <input type="checkbox" name="customer[accepts_marketing]" value="true">
      <span>{{ 'customer.register.marketing' | t }}</span>
    </label>
    <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
  <p class="account-form__alt">{{ 'customer.register.have_account' | t }} <a href="{{ routes.account_login_url }}" class="link-underline">{{ 'customer.login.title' | t }}</a></p>
</div>

{% schema %}
{ "name": "Cadastro", "class": "section-register", "settings": [] }
{% endschema %}
