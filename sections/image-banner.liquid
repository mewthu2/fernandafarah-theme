{%- liquid
  assign loading = 'lazy'
  if section.index <= 2
    assign loading = 'eager'
  endif
-%}

<div class="banner banner--{{ section.settings.width }} section-spacing" style="--slide-color: {{ section.settings.text_color }}; --banner-mt: {{ section.settings.margin_top }}px; --banner-mb: {{ section.settings.margin_bottom }}px;">
  <div class="banner__frame">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="slide__cover-link" aria-label="{{ section.settings.heading | default: section.settings.button_label | default: 'banner' | escape }}"></a>
    {%- endif -%}
    <div class="banner__media">
      {%- if section.settings.video_url != blank -%}
        <video class="banner__video{% if section.settings.video_url_mobile != blank %} hide-mobile{% endif %}" src="{{ section.settings.video_url }}" autoplay muted loop playsinline preload="metadata"></video>
        {%- if section.settings.video_url_mobile != blank -%}
          <video class="banner__video hide-desktop" src="{{ section.settings.video_url_mobile }}" autoplay muted loop playsinline preload="metadata"></video>
        {%- endif -%}
      {%- elsif section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w">
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag: loading: loading, sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', class: 'banner__img'
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__img placeholder' }}
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
      <div class="slide__content slide__content--{{ section.settings.position }} slide__content--mobile-{{ section.settings.position_mobile }}">
        <div class="slide__box text-{{ section.settings.alignment }}">
          {%- if section.settings.subheading != blank -%}
            <p class="slide__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="slide__heading heading-xl">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="slide__text">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <span class="button button--{{ section.settings.button_style }}">{{ section.settings.button_label }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Banner",
  "class": "section-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
    { "type": "text", "id": "video_url", "label": "URL de vídeo MP4 (desktop)", "info": "Substitui a imagem." },
    { "type": "text", "id": "video_url_mobile", "label": "URL de vídeo MP4 (mobile)" },
    { "type": "url", "id": "link", "label": "Link do banner" },
    {
      "type": "select",
      "id": "width",
      "label": "Largura",
      "options": [
        { "value": "full", "label": "Largura total" },
        { "value": "boxed", "label": "Com margens" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "margin_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },
    { "type": "header", "content": "Conteúdo (opcional)" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto do botão" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo do botão",
      "options": [
        { "value": "outline-light", "label": "Contorno claro" },
        { "value": "light", "label": "Sólido claro" },
        { "value": "outline", "label": "Contorno escuro" },
        { "value": "primary", "label": "Sólido escuro" }
      ],
      "default": "outline-light"
    },
    { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#FFFFFF" },
    {
      "type": "select",
      "id": "position",
      "label": "Posição (desktop)",
      "options": [
        { "value": "top-left", "label": "Topo à esquerda" },
        { "value": "top-center", "label": "Topo ao centro" },
        { "value": "top-right", "label": "Topo à direita" },
        { "value": "middle-left", "label": "Meio à esquerda" },
        { "value": "middle-center", "label": "Centro" },
        { "value": "middle-right", "label": "Meio à direita" },
        { "value": "bottom-left", "label": "Base à esquerda" },
        { "value": "bottom-center", "label": "Base ao centro" },
        { "value": "bottom-right", "label": "Base à direita" }
      ],
      "default": "bottom-center"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "Posição (mobile)",
      "options": [
        { "value": "top", "label": "Topo" },
        { "value": "middle", "label": "Centro" },
        { "value": "bottom", "label": "Base" }
      ],
      "default": "bottom"
    },
    { "type": "text_alignment", "id": "alignment", "label": "Alinhamento", "default": "center" }
  ],
  "presets": [
    { "name": "Banner" }
  ]
}
{% endschema %}
