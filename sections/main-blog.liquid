<div class="blog page-width section-spacing" style="--banner-mt: 32px; --banner-mb: 48px;">
  <h1 class="page-title">{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="blog__grid" role="list">
      {%- for article in blog.articles -%}
        <li class="blog-card">
          <a href="{{ article.url }}">
            <div class="blog-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 900', class: 'blog-card__img' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'blog-card__img placeholder' }}
              {%- endif -%}
            </div>
            <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="blog-card__title">{{ article.title | escape }}</h2>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate, style: 'numbers' %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
