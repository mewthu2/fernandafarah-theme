{%- if predictive_search.performed -%}
  <div class="predictive">
    {%- if predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 -%}
      <div class="predictive__side">
        {%- if predictive_search.resources.queries.size > 0 -%}
          <p class="predictive__heading">{{ 'search.suggestions' | t }}</p>
          <ul role="list">
            {%- for query in predictive_search.resources.queries -%}
              <li><a href="{{ query.url }}">{{ query.styled_text }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if predictive_search.resources.collections.size > 0 -%}
          <p class="predictive__heading">{{ 'search.collections' | t }}</p>
          <ul role="list">
            {%- for collection in predictive_search.resources.collections -%}
              <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="predictive__main">
      {%- if predictive_search.resources.products.size > 0 -%}
        <p class="predictive__heading">{{ 'search.products' | t }}</p>
        <div class="predictive__grid">
          {%- for product in predictive_search.resources.products limit: 4 -%}
            {% render 'product-card', product: product, sizes: '(min-width: 990px) 15vw, 50vw' %}
          {%- endfor -%}
        </div>
        <a class="button button--outline" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product">
          {{ 'search.view_all' | t: terms: predictive_search.terms }}
        </a>
      {%- else -%}
        <p class="predictive__empty">{{ 'search.no_results' | t: terms: predictive_search.terms }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Busca preditiva",
  "settings": []
}
{% endschema %}
