{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="gift-card page-width page-width--narrow">
      <p class="header__logo-text">{{ shop.name }}</p>
      <h1 class="page-title">{{ 'gift_card.title' | t }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="eyebrow">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      <p class="gift-card__value">{{ gift_card.balance | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p>{{ 'gift_card.initial' | t }}: {{ gift_card.initial_value | money }}</p>
      {%- endif -%}
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      {%- if gift_card.expires_on -%}
        <p>{{ 'gift_card.expires' | t }}: {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
      {%- endif -%}
      <a href="{{ shop.url }}" class="button">{{ 'cart.continue' | t }}</a>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="link-underline">Apple Wallet</a>
      {%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
