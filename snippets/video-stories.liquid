{% doc %}
  Renders a floating video bubble and an Instagram-style stories modal with the product videos,
  price, variant options and add to cart. Variant changes are synced with the main product form.

  @param {product} product - The product
  @param {variant} current_variant - Currently selected variant
  @param {string} section_id - Main product section id
  @param {string} [position] - Bubble position: 'left' or 'right'

  @example
  {% render 'video-stories', product: product, current_variant: current_variant, section_id: section.id %}
{% enddoc %}

{%- liquid
  capture video_urls
    render 'product-video-url', product: product, all: true, max_height: 1080
  endcapture
  assign video_list = video_urls | strip | split: ' '
  assign position = position | default: 'left'
  assign color_names = settings.card_color_option_name | downcase | split: ','
  capture color_map
    render 'color-map', product: product
  endcapture
  assign poster = ''
  if product.featured_media
    assign poster = product.featured_media | image_url: width: 300
  endif
-%}

{%- if video_list.size > 0 -%}
  <div class="vstories vstories--{{ position }}" data-vstories data-variant-id="{{ current_variant.id }}">
    <button type="button" class="vstories__bubble" data-vstories-open aria-label="{{ 'products.stories.open' | t }}">
      <span class="vstories__ring">
        <video
          class="vstories__bubble-video"
          src="{{ video_list.first }}"
          {% if poster != blank %}
            poster="{{ poster }}"
          {% endif %}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      </span>
      {%- if video_list.size > 1 -%}
        <span class="vstories__count">{{ video_list.size }}</span>
      {%- endif -%}
    </button>

    <dialog class="vstories__dialog" data-vstories-dialog aria-label="{{ 'products.stories.title' | t: product: product.title }}">
      <button type="button" class="vstories__arrow vstories__arrow--prev" data-vs-prev aria-label="{{ 'general.previous' | t }}">
        {% render 'icon', icon: 'arrow-left' %}
      </button>

      <div class="vstories__frame">
        <div class="vstories__progress" aria-hidden="true">
          {%- for url in video_list -%}
            <span class="vstories__bar"><i></i></span>
          {%- endfor -%}
        </div>

        <div class="vstories__top">
          <div class="vstories__brand">
            {%- if product.featured_media -%}
              {{ product.featured_media | image_url: width: 80 | image_tag: class: 'vstories__avatar', alt: '', loading: 'lazy' }}
            {%- endif -%}
            <span>{{ product.title | escape }}</span>
          </div>
          <div class="vstories__controls">
            <button type="button" class="vstories__icon" data-vs-mute aria-label="{{ 'products.stories.sound' | t }}">
              <svg class="vs-sound-on" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"/></svg>
              <svg class="vs-sound-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="m16 9 5 6M21 9l-5 6"/></svg>
            </button>
            <button type="button" class="vstories__icon" data-vs-close aria-label="{{ 'general.close' | t }}">
              {% render 'icon', icon: 'close' %}
            </button>
          </div>
        </div>

        <div class="vstories__stage" data-vs-stage>
          {%- for url in video_list -%}
            <video
              class="vstories__video{% if forloop.first %} is-active{% endif %}"
              data-src="{{ url }}"
              {% if forloop.first and poster != blank %}
                poster="{{ product.featured_media | image_url: width: 900 }}"
              {% endif %}
              playsinline
              preload="none"
            ></video>
          {%- endfor -%}
          <button type="button" class="vstories__tap vstories__tap--prev" data-vs-tap="-1" aria-label="{{ 'general.previous' | t }}"></button>
          <button type="button" class="vstories__tap vstories__tap--next" data-vs-tap="1" aria-label="{{ 'general.next' | t }}"></button>
        </div>

        <div class="vstories__panel">
          <div class="vstories__head">
            <a href="{{ product.url }}" class="vstories__title">{{ product.title | escape }}</a>
            <div class="vstories__price" data-vs-price>
              {% render 'price', product: product, variant: current_variant, show_installments: true, large: true %}
            </div>
          </div>

          {%- unless product.has_only_default_variant -%}
            <div class="vstories__options" data-vs-options>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_down = option.name | downcase | strip
                  assign is_color = false
                  for name in color_names
                    assign trimmed = name | strip
                    if trimmed == option_down
                      assign is_color = true
                    endif
                  endfor
                -%}
                <fieldset class="vstories__option" data-option-index="{{ forloop.index0 }}">
                  <legend class="visually-hidden">{{ option.name }}</legend>
                  {%- for value in option.values -%}
                    {%- liquid
                      assign input_id = 'vs-' | append: section_id | append: '-' | append: option.position | append: '-' | append: forloop.index0
                      assign swatch_style = ''
                      if is_color
                        capture swatch_style
                          render 'swatch-style', value: value, color_map: color_map
                        endcapture
                        assign swatch_style = swatch_style | strip
                      endif
                    -%}
                    <input
                      type="radio"
                      class="visually-hidden"
                      id="{{ input_id }}"
                      name="vs-{{ section_id }}-{{ option.position }}"
                      value="{{ value | escape }}"
                      {% if value.selected %}
                        checked
                      {% endif %}
                    >
                    <label
                      for="{{ input_id }}"
                      class="{% if is_color %}swatch swatch--lg{% else %}size-pill{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                      {% if is_color %}
                        style="{{ swatch_style }}" title="{{ value | escape }}"
                      {% endif %}
                    >
                      {%- if is_color -%}
                        <span class="visually-hidden">{{ value }}</span>
                      {%- else -%}
                        {{ value }}
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <script type="application/json" data-variants>
            {{ product.variants | json }}
          </script>
          <button
            type="button"
            class="button button--full vstories__add"
            data-vs-add
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      </div>

      <button type="button" class="vstories__arrow vstories__arrow--next" data-vs-next aria-label="{{ 'general.next' | t }}">
        {% render 'icon', icon: 'arrow-right' %}
      </button>
    </dialog>
  </div>
{%- endif -%}
