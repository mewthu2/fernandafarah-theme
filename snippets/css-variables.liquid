{% doc %}
  Outputs font faces and CSS custom properties from theme settings.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign heading_font = settings.font_heading
  assign body_font = settings.font_body
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign heading_font_light = heading_font | font_modify: 'weight', '300'
-%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_light | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}

  :root {
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-scale: {{ settings.font_body_scale | divided_by: 100.0 }};
    --font-heading-scale: {{ settings.font_heading_scale | divided_by: 100.0 }};
    --heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};

    --color-bg: {{ settings.color_background }};
    --color-text: {{ settings.color_text }};
    --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
    --color-muted: {{ settings.color_muted }};
    --color-border: {{ settings.color_border }};
    --color-surface: {{ settings.color_surface }};
    --color-accent: {{ settings.color_accent }};
    --color-sale: {{ settings.color_sale }};
    --color-button: {{ settings.color_button }};
    --color-button-text: {{ settings.color_button_text }};

    --page-width: {{ settings.page_width }}px;
    --button-radius: {{ settings.button_radius }}px;
    --logo-width: {{ settings.logo_width }}px;

    {%- case settings.card_image_ratio -%}
      {%- when 'square' -%}
        --card-ratio: 1 / 1;
      {%- when 'tall' -%}
        --card-ratio: 3 / 4;
      {%- when 'adapt' -%}
        --card-ratio: auto;
      {%- else -%}
        --card-ratio: 2 / 3;
    {%- endcase %}
  }
{% endstyle %}
