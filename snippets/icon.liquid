{% doc %}
  Renders an inline SVG icon.

  @param {string} icon - Icon name: search, account, bag, heart, close, menu, arrow-left, arrow-right, chevron-down, plus, minus, whatsapp, instagram, facebook, tiktok, pinterest, youtube, spotify, filter, play, pause, pin, truck

  @example
  {% render 'icon', icon: 'bag' %}
{% enddoc %}

{%- case icon -%}
