{% doc %}
  Renders customer address form fields.

  @param {object} form - The customer_address form object
  @param {string} prefix - Unique prefix for field ids

  @example
  {% render 'address-fields', form: form, prefix: 'new' %}
{% enddoc %}

{{ form.errors | default_errors }}
<div class="form__row">
  <div class="field">
    <label for="AddrFirst-{{ prefix }}">{{ 'customer.first_name' | t }}</label>
    <input type="text" id="AddrFirst-{{ prefix }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="field">
    <label for="AddrLast-{{ prefix }}">{{ 'customer.last_name' | t }}</label>
    <input type="text" id="AddrLast-{{ prefix }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="field">
  <label for="AddrZip-{{ prefix }}">{{ 'customer.addresses.zip' | t }}</label>
  <input type="text" id="AddrZip-{{ prefix }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
</div>
<div class="field">
  <label for="AddrAddress1-{{ prefix }}">{{ 'customer.addresses.address1' | t }}</label>
  <input type="text" id="AddrAddress1-{{ prefix }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label for="AddrAddress2-{{ prefix }}">{{ 'customer.addresses.address2' | t }}</label>
  <input type="text" id="AddrAddress2-{{ prefix }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="form__row">
  <div class="field">
    <label for="AddrCity-{{ prefix }}">{{ 'customer.addresses.city' | t }}</label>
    <input type="text" id="AddrCity-{{ prefix }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="field">
    <label for="AddrProvince-{{ prefix }}">{{ 'customer.addresses.province' | t }}</label>
    <input type="text" id="AddrProvince-{{ prefix }}" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
  </div>
</div>
<div class="form__row">
  <div class="field">
    <label for="AddrCountry-{{ prefix }}">{{ 'customer.addresses.country' | t }}</label>
    <select id="AddrCountry-{{ prefix }}" name="address[country]" autocomplete="country">
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="field">
    <label for="AddrPhone-{{ prefix }}">{{ 'contact.phone' | t }}</label>
    <input type="tel" id="AddrPhone-{{ prefix }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
  </div>
</div>
<label class="checkbox">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
