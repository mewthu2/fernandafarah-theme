{% doc %}
  Renders breadcrumbs for collection, product and page templates.

  @example
  {% render 'breadcrumbs' %}
{% enddoc %}

<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
  <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
  {%- case request.page_type -%}
    {%- when 'collection' -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title | escape }}</span>
    {%- when 'product' -%}
      {%- if collection -%}
        <span aria-hidden="true">/</span>
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    {%- when 'page' -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title | escape }}</span>
    {%- when 'search' -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ 'search.title' | t }}</span>
  {%- endcase -%}
</nav>
